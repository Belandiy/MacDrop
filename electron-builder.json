{
  "appId": "com.andrey.macdrop",
  "productName": "MacDrop",
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "Belandiy",
    "repo": "MacDrop"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "public/**/*",
    "bin/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MacDrop"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      },
      {
        "target": "zip",
        "arch": ["arm64", "x64"]
      }
    ],
    "category": "public.app-category.utilities",
    "icon": "public/icon.png",
    "identity": null
  }
}
