{
  "name": "macdrop",
  "version": "2.1.0",
  "description": "Cross-platform local network file transfer app (Mac & Windows)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:win": "tsc && vite build && electron-builder --win",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "start": "electron .",
    "test": "vitest"
  },
  "keywords": [
    "file-transfer",
    "airdrop",
    "p2p",
    "mac",
    "windows"
  ],
  "author": "Andrey",
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.1"
  }
}
